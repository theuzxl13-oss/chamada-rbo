# ---------------------------------------------------------------------------
# Modo HOSPEDADO (Render + Supabase) — link na internet, vários aparelhos.
# Copie os valores em Supabase → Project Settings → API.
# No Render: serviço → Environment.
# Localmente: copie este arquivo para ".env.local" e preencha.
# ---------------------------------------------------------------------------

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (pode aparecer no navegador; só permite LER o estado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA "service_role" — usada só no servidor. NUNCA compartilhe
# nem coloque no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Modo LOCAL (sem Supabase): deixe as variáveis acima vazias.
# Os dados ficam no arquivo ./data/estado.json deste computador.
# RBO_DATA_DIR=./data
# ---------------------------------------------------------------------------
